diff --git a/libkern/crypto/corecrypto_sha1.c b/libkern/crypto/corecrypto_sha1.c
--- a/libkern/crypto/corecrypto_sha1.c
+++ b/libkern/crypto/corecrypto_sha1.c
@@ -16,6 +16,158 @@
 	ctx->c.b64[0] = count;
 }
 
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+/*
+ * Nothing on this platform ever calls register_crypto_functions(): real iOS
+ * kernelcaches carry com.apple.kec.corecrypto as a static kext, ours does
+ * not, so g_crypto_funcs stays NULL for the whole life of the kernel.
+ *
+ * The three entry points below assume it is populated:
+ *
+ *	const struct ccdigest_info *di = g_crypto_funcs->ccsha1_di;
+ *
+ * and the first caller is very early -- IOPlatformExpertDevice::
+ * generatePlatformUUID() hashes /chosen's unique-chip-id and chip-id, which
+ * runs from PE_init_iokit() long before any kext could register anything:
+ *
+ *	Kernel data abort at pc _sha1_init+0x34, far 0x28
+ *	IOPlatformExpertDevice::generatePlatformUUID -> _sha1_init
+ *
+ * Serve SHA-1 from a plain software implementation when no crypto provider
+ * has registered.  The byte counter in SHA1_CTX->c matches what DiToSHA1()
+ * and SHA1ToDi() expect (ccdigest counts bytes, not bits).
+ */
+static void
+polaris_sha1_transform(uint32_t state[5], const uint8_t block[64])
+{
+	uint32_t w[80];
+	uint32_t a, b, c, d, e;
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		w[i] = ((uint32_t)block[i * 4] << 24) |
+		    ((uint32_t)block[i * 4 + 1] << 16) |
+		    ((uint32_t)block[i * 4 + 2] << 8) |
+		    (uint32_t)block[i * 4 + 3];
+	}
+	for (i = 16; i < 80; i++) {
+		uint32_t t = w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16];
+		w[i] = (t << 1) | (t >> 31);
+	}
+
+	a = state[0];
+	b = state[1];
+	c = state[2];
+	d = state[3];
+	e = state[4];
+
+	for (i = 0; i < 80; i++) {
+		uint32_t f, k, t;
+
+		if (i < 20) {
+			f = (b & c) | (~b & d);
+			k = 0x5a827999;
+		} else if (i < 40) {
+			f = b ^ c ^ d;
+			k = 0x6ed9eba1;
+		} else if (i < 60) {
+			f = (b & c) | (b & d) | (c & d);
+			k = 0x8f1bbcdc;
+		} else {
+			f = b ^ c ^ d;
+			k = 0xca62c1d6;
+		}
+		t = ((a << 5) | (a >> 27)) + f + e + k + w[i];
+		e = d;
+		d = c;
+		c = (b << 30) | (b >> 2);
+		b = a;
+		a = t;
+	}
+
+	state[0] += a;
+	state[1] += b;
+	state[2] += c;
+	state[3] += d;
+	state[4] += e;
+}
+
+static void
+polaris_sha1_init(SHA1_CTX *ctx)
+{
+	ctx->h.b32[0] = 0x67452301;
+	ctx->h.b32[1] = 0xefcdab89;
+	ctx->h.b32[2] = 0x98badcfe;
+	ctx->h.b32[3] = 0x10325476;
+	ctx->h.b32[4] = 0xc3d2e1f0;
+	ctx->c.b64[0] = 0;
+	ctx->count = 0;
+}
+
+static void
+polaris_sha1_update(SHA1_CTX *ctx, const void *data, size_t len)
+{
+	const uint8_t *p = (const uint8_t *)data;
+	size_t idx = (size_t)(getCount(ctx) & 63u);
+
+	ctx->c.b64[0] += (uint64_t)len;
+
+	if (idx != 0) {
+		size_t need = 64 - idx;
+
+		if (len < need) {
+			memcpy(ctx->m.b8 + idx, p, len);
+			return;
+		}
+		memcpy(ctx->m.b8 + idx, p, need);
+		polaris_sha1_transform(ctx->h.b32, ctx->m.b8);
+		p += need;
+		len -= need;
+	}
+	while (len >= 64) {
+		polaris_sha1_transform(ctx->h.b32, p);
+		p += 64;
+		len -= 64;
+	}
+	if (len != 0) {
+		memcpy(ctx->m.b8, p, len);
+	}
+}
+
+static void
+polaris_sha1_final(void *digest, SHA1_CTX *ctx)
+{
+	uint8_t *out = (uint8_t *)digest;
+	uint64_t bits = getCount(ctx) << 3;
+	size_t idx = (size_t)(getCount(ctx) & 63u);
+	int i;
+
+	ctx->m.b8[idx++] = 0x80;
+	if (idx > 56) {
+		for (i = (int)idx; i < 64; i++) {
+			ctx->m.b8[i] = 0;
+		}
+		polaris_sha1_transform(ctx->h.b32, ctx->m.b8);
+		idx = 0;
+	}
+	for (i = (int)idx; i < 56; i++) {
+		ctx->m.b8[i] = 0;
+	}
+	for (i = 0; i < 8; i++) {
+		ctx->m.b8[56 + i] = (uint8_t)(bits >> (56 - 8 * i));
+	}
+	polaris_sha1_transform(ctx->h.b32, ctx->m.b8);
+
+	for (i = 0; i < 5; i++) {
+		out[i * 4 + 0] = (uint8_t)(ctx->h.b32[i] >> 24);
+		out[i * 4 + 1] = (uint8_t)(ctx->h.b32[i] >> 16);
+		out[i * 4 + 2] = (uint8_t)(ctx->h.b32[i] >> 8);
+		out[i * 4 + 3] = (uint8_t)(ctx->h.b32[i]);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_POLARIS */
+
+
 /* Copy a ccdigest ctx into a legacy SHA1 context */
 static void
 DiToSHA1(const struct ccdigest_info *di, struct ccdigest_ctx *di_ctx, SHA1_CTX *sha1_ctx)
@@ -40,6 +192,12 @@
 void
 SHA1Init(SHA1_CTX *ctx)
 {
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	if (__builtin_expect(g_crypto_funcs == NULL, 0)) {
+		polaris_sha1_init(ctx);
+		return;
+	}
+#endif
 	const struct ccdigest_info *di = g_crypto_funcs->ccsha1_di;
 	ccdigest_di_decl(di, di_ctx);
 
@@ -51,6 +209,12 @@
 void
 SHA1Update(SHA1_CTX *ctx, const void *data, size_t len)
 {
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	if (__builtin_expect(g_crypto_funcs == NULL, 0)) {
+		polaris_sha1_update(ctx, data, len);
+		return;
+	}
+#endif
 	const struct ccdigest_info *di = g_crypto_funcs->ccsha1_di;
 	ccdigest_di_decl(di, di_ctx);
 
@@ -62,6 +226,12 @@
 void
 SHA1Final(void *digest, SHA1_CTX *ctx)
 {
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	if (__builtin_expect(g_crypto_funcs == NULL, 0)) {
+		polaris_sha1_final(digest, ctx);
+		return;
+	}
+#endif
 	const struct ccdigest_info *di = g_crypto_funcs->ccsha1_di;
 	ccdigest_di_decl(di, di_ctx);
 
