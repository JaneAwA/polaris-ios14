 	bsd_autoconf();
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	polaris_note("D3", 0, 0, 0);
+#endif
 
 #if CONFIG_DTRACE
 	dtrace_postinit();
@@ -921,6 +934,9 @@
 	inittodr(0);
 
 	/* Mount the root file system. */
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	polaris_note("D4", 0, 0, 0);
+#endif
 	while (TRUE) {
 		int err;
 
