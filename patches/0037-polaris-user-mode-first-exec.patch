diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -913,7 +913,19 @@
 void
 IOSecureBSDRoot(const char * rootName)
 {
-#if CONFIG_SECURE_BSD_ROOT
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	/*
+	 * POLARIS: nothing publishes an "IOPlatformExpert" service here -- that
+	 * normally comes from the AppleARMPlatformExpert kext, which we do not
+	 * have.  waitForMatchingService() would block for its full 30 second
+	 * timeout and then return NULL, and the very next statement
+	 * (matching->release() / pe->callPlatformFunction()) dereferences it.
+	 * The secure-root check only decides whether to throw the memory device
+	 * away, so skipping it is both safe and much faster.
+	 */
+	(void)rootName;
+	return;
+#elif CONFIG_SECURE_BSD_ROOT
 	IOReturn         result;
 	IOPlatformExpert *pe;
 	OSDictionary     *matching;
