+	polaris_pthread_missing("workq_markfree_threadstack");
+}
+
+static const struct pthread_functions_s polaris_pthread_functions = {
+	.version = 1,
+
+	.pthread_init = polaris_pthread_init,
+	.pth_proc_hashinit = polaris_pth_proc_hashinit,
+	.pth_proc_hashdelete = polaris_pth_proc_hashdelete,
+
+	.bsdthread_create = polaris_bsdthread_create,
+	.bsdthread_register = polaris_bsdthread_register,
+	.bsdthread_register2 = polaris_bsdthread_register2,
+	.bsdthread_terminate = polaris_bsdthread_terminate,
+	.thread_selfid = polaris_thread_selfid,
+
+	.psynch_mutexwait = polaris_psynch_mutexwait,
+	.psynch_mutexdrop = polaris_psynch_mutexdrop,
+	.psynch_cvbroad = polaris_psynch_cvbroad,
+	.psynch_cvsignal = polaris_psynch_cvsignal,
+	.psynch_cvwait = polaris_psynch_cvwait,
+	.psynch_cvclrprepost = polaris_psynch_cvclrprepost,
+	.psynch_rw_longrdlock = polaris_psynch_rw_longrdlock,
+	.psynch_rw_rdlock = polaris_psynch_rw_rdlock,
+	.psynch_rw_unlock = polaris_psynch_rw_unlock,
+	.psynch_rw_wrlock = polaris_psynch_rw_wrlock,
+	.psynch_rw_yieldwrlock = polaris_psynch_rw_yieldwrlock,
+
+	.pthread_find_owner = polaris_pthread_find_owner,
+	.pthread_get_thread_kwq = polaris_pthread_get_thread_kwq,
+
+	.workq_handle_stack_events = polaris_workq_handle_stack_events,
+	.workq_create_threadstack = polaris_workq_create_threadstack,
+	.workq_destroy_threadstack = polaris_workq_destroy_threadstack,
+	.workq_setup_thread = polaris_workq_setup_thread,
+	.workq_markfree_threadstack = polaris_workq_markfree_threadstack,
+};
+
+void
+polaris_pthread_install(void)
+{
+	pthread_callbacks_t callbacks = NULL;
+
+	if (pthread_functions != NULL) {
+		return;
+	}
+
+	pthread_kext_register(&polaris_pthread_functions, &callbacks);
+	polaris_note("PTA", (uint64_t)callbacks, (uint64_t)pthread_functions, 0);
+}
+#endif /* ARM64_BOARD_CONFIG_POLARIS */
