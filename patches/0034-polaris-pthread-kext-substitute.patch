+}
+
+static int
+polaris_psynch_cvwait(proc_t p, user_addr_t cv, uint64_t cvlsgen,
+    uint32_t cvugen, user_addr_t mutex, uint64_t mugen, uint32_t flags,
+    int64_t sec, uint32_t nsec, uint32_t *retval)
+{
+	(void)p; (void)cv; (void)cvlsgen; (void)cvugen; (void)mutex; (void)mugen;
+	(void)flags; (void)sec; (void)nsec; (void)retval;
+	polaris_pthread_missing("psynch_cvwait");
+	return 0;
+}
+
+static int
+polaris_psynch_cvclrprepost(proc_t p, user_addr_t cv, uint32_t cvgen,
+    uint32_t cvugen, uint32_t cvsgen, uint32_t prepocnt, uint32_t preposeq,
+    uint32_t flags, int *retval)
+{
+	(void)p; (void)cv; (void)cvgen; (void)cvugen; (void)cvsgen; (void)prepocnt;
+	(void)preposeq; (void)flags; (void)retval;
+	polaris_pthread_missing("psynch_cvclrprepost");
+	return 0;
+}
+
+#define POLARIS_PSYNCH_RW_STUB(fn, name)                                  \
+	static int                                                        \
+	fn(proc_t p, user_addr_t rwlock, uint32_t lgenval,                \
+	    uint32_t ugenval, uint32_t rw_wc, int flags, uint32_t *retval) \
+	{                                                                 \
+	        (void)p; (void)rwlock; (void)lgenval; (void)ugenval;      \
+	        (void)rw_wc; (void)flags; (void)retval;                   \
+	        polaris_pthread_missing(name);                            \
+	        return 0;                                                 \
+	}
+
+POLARIS_PSYNCH_RW_STUB(polaris_psynch_rw_longrdlock, "psynch_rw_longrdlock")
+POLARIS_PSYNCH_RW_STUB(polaris_psynch_rw_rdlock, "psynch_rw_rdlock")
+POLARIS_PSYNCH_RW_STUB(polaris_psynch_rw_unlock, "psynch_rw_unlock")
+POLARIS_PSYNCH_RW_STUB(polaris_psynch_rw_wrlock, "psynch_rw_wrlock")
+POLARIS_PSYNCH_RW_STUB(polaris_psynch_rw_yieldwrlock, "psynch_rw_yieldwrlock")
+
+static void
+polaris_pthread_find_owner(thread_t thread,
+    struct stackshot_thread_waitinfo *waitinfo)
+{
+	(void)thread; (void)waitinfo;
+}
+
+static void *
+polaris_pthread_get_thread_kwq(thread_t thread)
+{
+	(void)thread;
+	return NULL;
+}
+
+static int
+polaris_workq_handle_stack_events(proc_t p, thread_t th, vm_map_t map,
+    user_addr_t stackaddr, mach_port_name_t kport, user_addr_t events,
+    int nevents, int upcall_flags)
+{
+	(void)p; (void)th; (void)map; (void)stackaddr; (void)kport; (void)events;
+	(void)nevents; (void)upcall_flags;
+	polaris_pthread_missing("workq_handle_stack_events");
+	return 0;
+}
+
+static int
+polaris_workq_create_threadstack(proc_t p, vm_map_t vmap,
+    mach_vm_offset_t *out_addr)
+{
+	(void)p; (void)vmap; (void)out_addr;
+	polaris_pthread_missing("workq_create_threadstack");
+	return 0;
+}
+
+static int
+polaris_workq_destroy_threadstack(proc_t p, vm_map_t vmap,
+    mach_vm_offset_t stackaddr)
+{
+	(void)p; (void)vmap; (void)stackaddr;
+	polaris_pthread_missing("workq_destroy_threadstack");
+	return 0;
+}
+
+static void
+polaris_workq_setup_thread(proc_t p, thread_t th, vm_map_t map,
+    user_addr_t stackaddr, mach_port_name_t kport, int th_qos, int setup_flags,
+    int upcall_flags)
+{
+	(void)p; (void)th; (void)map; (void)stackaddr; (void)kport; (void)th_qos;
