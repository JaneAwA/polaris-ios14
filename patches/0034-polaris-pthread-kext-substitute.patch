diff --git a/bsd/pthread/pthread_shims.c b/bsd/pthread/pthread_shims.c
--- a/bsd/pthread/pthread_shims.c
+++ b/bsd/pthread/pthread_shims.c
@@ -310,9 +310,20 @@
 
 /* kernel (core) to kext shims */
 
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+extern void polaris_pthread_install(void);
+#endif
+
 void
 pthread_init(void)
 {
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	/*
+	 * There is no pthread kext on this platform, so register our own
+	 * function table before the NULL check below.
+	 */
+	polaris_pthread_install();
+#endif
 	if (!pthread_functions) {
 		panic("pthread kernel extension not loaded (function table is NULL).");
 	}
@@ -609,3 +620,301 @@
 		pthread_functions = fns;
 	}
 }
+
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+/*
+ * Polaris boots a kernel with no extensions at all: the pthread kext
+ * (com.apple.kec.pthread) is a prelinked kernel extension inside the iOS
+ * kernelcache, and there is neither a kernelcache nor a kext loader here.
+ *
+ * bsd_init() calls pthread_init() unconditionally, so the shims would panic
+ * with "function table is NULL" long before the boot ever reaches
+ * vfs_mountroot().  Register a table of our own instead.
+ *
+ * Everything early boot touches is implemented.  The entries only userland
+ * can reach are stubs that panic with their own name, which makes the next
+ * step readable straight off a screen photo.
+ */
+extern void polaris_note(const char *tag, uint64_t a, uint64_t b, uint64_t c);
+
+static void
+polaris_pthread_missing(const char *what)
+{
+	panic("polaris: pthread entry point %s is not implemented", what);
+}
+
+static void
+polaris_pthread_init(void)
+{
+	polaris_note("PTB", 0, 0, 0);
+}
+
+static void
+polaris_pth_proc_hashinit(proc_t p)
+{
+	(void)p;
+}
+
+static void
+polaris_pth_proc_hashdelete(proc_t p)
+{
+	(void)p;
+}
+
+static int
+polaris_bsdthread_register(struct proc *p, user_addr_t threadstart,
+    user_addr_t wqthread, int pthsize, user_addr_t dummy_value,
+    user_addr_t targetconc_ptr, uint64_t dispatchqueue_offset, int32_t *retval)
+{
+	(void)dummy_value;
+	(void)targetconc_ptr;
+
+	pthread_kern->proc_set_threadstart(p, threadstart);
+	pthread_kern->proc_set_wqthread(p, wqthread);
+	pthread_kern->proc_set_pthsize(p, pthsize);
+	pthread_kern->proc_set_dispatchqueue_offset(p, dispatchqueue_offset);
+
+	polaris_note("PT1", threadstart, wqthread, (uint64_t)pthsize);
+	*retval = 0;
+	return 0;
+}
+
+static int
+polaris_bsdthread_register2(struct proc *p, user_addr_t threadstart,
+    user_addr_t wqthread, uint32_t flags, user_addr_t stack_addr_hint,
+    user_addr_t targetconc_ptr, uint32_t dispatchqueue_offset,
+    uint32_t tsd_offset, int32_t *retval)
+{
+	(void)flags;
+	(void)targetconc_ptr;
+
+	pthread_kern->proc_set_threadstart(p, threadstart);
+	pthread_kern->proc_set_wqthread(p, wqthread);
+	pthread_kern->proc_set_stack_addr_hint(p, stack_addr_hint);
+	pthread_kern->proc_set_dispatchqueue_offset(p, dispatchqueue_offset);
+	pthread_kern->proc_set_pthread_tsd_offset(p, tsd_offset);
+
+	polaris_note("PT2", threadstart, wqthread, (uint64_t)dispatchqueue_offset);
+	*retval = 0;
+	return 0;
+}
+
+static int
+polaris_thread_selfid(struct proc *p, uint64_t *retval)
+{
+	(void)p;
+	*retval = thread_tid(current_thread());
+	return 0;
+}
+
+/* Not implemented yet: userland-only entry points.  Each names itself. */
+static int
+polaris_bsdthread_create(struct proc *p, user_addr_t user_func,
+    user_addr_t user_funcarg, user_addr_t user_stack, user_addr_t user_pthread,
+    uint32_t flags, user_addr_t *retval)
+{
+	(void)p; (void)user_func; (void)user_funcarg; (void)user_stack;
+	(void)user_pthread; (void)flags; (void)retval;
+	polaris_pthread_missing("bsdthread_create");
+	return 0;
+}
+
+static int
+polaris_bsdthread_terminate(struct proc *p, user_addr_t stackaddr, size_t size,
+    uint32_t kthport, uint32_t sem, int32_t *retval)
+{
+	(void)p; (void)stackaddr; (void)size; (void)kthport; (void)sem; (void)retval;
+	polaris_pthread_missing("bsdthread_terminate");
+	return 0;
+}
+
+static int
+polaris_psynch_mutexwait(proc_t p, user_addr_t mutex, uint32_t mgen,
+    uint32_t ugen, uint64_t tid, uint32_t flags, uint32_t *retval)
+{
+	(void)p; (void)mutex; (void)mgen; (void)ugen; (void)tid; (void)flags;
+	(void)retval;
+	polaris_pthread_missing("psynch_mutexwait");
+	return 0;
+}
+
+static int
+polaris_psynch_mutexdrop(proc_t p, user_addr_t mutex, uint32_t mgen,
