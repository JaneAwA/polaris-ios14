+}
+
+static int
+polaris_psynch_cvbroad(proc_t p, user_addr_t cv, uint64_t cvlsgen,
+    uint64_t cvudgen, uint32_t flags, user_addr_t mutex, uint64_t mugen,
+    uint64_t tid, uint32_t *retval)
+{
+	(void)p; (void)cv; (void)cvlsgen; (void)cvudgen; (void)flags; (void)mutex;
