+
+static int
+polaris_psynch_cvsignal(proc_t p, user_addr_t cv, uint64_t cvlsgen,
+    uint32_t cvugen, int thread_port, user_addr_t mutex, uint64_t mugen,
+    uint64_t tid, uint32_t flags, uint32_t *retval)
+{
+	(void)p; (void)cv; (void)cvlsgen; (void)cvugen; (void)thread_port;
