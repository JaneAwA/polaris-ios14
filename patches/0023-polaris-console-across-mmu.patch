diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1744,6 +1744,53 @@
 extern void polaris_boot_mark(unsigned int slot, unsigned int colour);
 extern void polaris_console_suspend(void);
 
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+/* pexpert/arm/pe_serial.c: move the console onto a kernel mapping. */
+extern void polaris_console_rebind(void *va);
+
+static vm_map_address_t polaris_console_va;
+
+/*
+ * POLARIS: give the panel a home in the kernel's own tables.
+ *
+ * The early console writes the raw framebuffer address, which only the
+ * bootstrap identity tables translate.  arm_vm_init() drops those when it
+ * installs TTBR0 = invalid_ttep, and nothing maps the panel again until the
+ * first ml_io_map() after pmap_init().  Everything in between -- the switch to
+ * the real TTBR1, pmap_bootstrap(), pmap_init() -- is invisible, which is why
+ * a failure there looks like a plain hang.
+ *
+ * Carve one 32 MB block out of the physmap's L1 slot, above physmap_end so the
+ * aperture never maps it, and describe the panel there with a single device
+ * block descriptor -- the same one start.s uses for the identity mapping.  The
+ * L2 table for that slot already exists: init_ptpages() built it for the
+ * aperture a few lines above.
+ */
+static void
+polaris_console_map_kernel(boot_args *args)
+{
+	vm_map_address_t fb_pa = args->Video.v_baseAddr;
+	vm_map_address_t va = (VM_MIN_KERNEL_ADDRESS - ARM_TT_L2_SIZE) +
+	    (fb_pa & ARM_TT_L2_OFFMASK);
+	tt_entry_t *l1_tte, *l2_tte;
+
+	polaris_console_va = 0;
+	l1_tte = cpu_tte + ((va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT);
+	if ((*l1_tte & ARM_TTE_VALID) == 0) {
+		return;         /* no L2 table over the aperture: stay on the raw address */
+	}
+	l2_tte = (tt_entry_t *)phystokv(*l1_tte & ARM_TTE_TABLE_MASK);
+	l2_tte += (va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT;
+	if (*l2_tte != ARM_TTE_EMPTY) {
+		return;         /* something already lives here */
+	}
+	*l2_tte = (fb_pa & ~(vm_map_address_t)ARM_TT_L2_OFFMASK) | 0x40d; /* valid | AF | attrindx 3 (device) */
+	__asm__ volatile("dsb sy" ::: "memory");
+	polaris_console_va = va;
+	polaris_console_rebind((void *)(uintptr_t)va);
+}
+#endif /* ARM64_BOARD_CONFIG_POLARIS */
+
 void
 arm_vm_init(uint64_t memory_size, boot_args * args)
 {
@@ -2089,21 +2136,31 @@
 	set_tbi();
 
 	arm_vm_physmap_init(args);
+
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	/* Do this while the bootstrap tables can still reach the framebuffer. */
+	polaris_console_map_kernel(args);
+#endif
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
 	ml_enable_monitor();
 
 	/*
 	 * Last point where the identity table still maps the panel: the next
-	 * store to TTBR0 drops it, and nothing maps the framebuffer again until
-	 * serial_init() runs after pmap_bootstrap().
+	 * store to TTBR0 drops it.  polaris_console_map_kernel() has already
+	 * pointed the console at a kernel mapping by now, so keep drawing.
 	 */
 	polaris_boot_mark(14, 0xffff8000u);
+	/* No-op when the block mapping above worked; otherwise stop drawing. */
 	polaris_console_suspend();
 
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
 	flush_mmu_tlb();
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	/* Running on the kernel's own tables with no identity map behind us. */
+	polaris_note("S1", polaris_console_va, 0, 0);
+#endif
 #if defined(HAS_VMSA_LOCK)
 	vmsa_lock();
 #endif
@@ -2138,6 +2195,9 @@
 		// The preliminary auxKC mapping has been broken up.
 		flush_mmu_tlb();
 	}
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	polaris_note("S2", segLOWEST, avail_start, dynamic_memory_begin);
+#endif
 
 	sane_size = mem_size - (avail_start - gPhysBase);
 	max_mem = mem_size;
@@ -2180,6 +2240,9 @@
 	}
 #endif
 	pmap_bootstrap(dynamic_memory_begin);
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	polaris_note("S3", dynamic_memory_begin, 0, 0);
+#endif
 
 	disable_preemption();
 
@@ -2301,4 +2364,7 @@
 	first_avail = avail_start;
 	patch_low_glo_static_region(args->topOfKernelData, avail_start - args->topOfKernelData);
 	enable_preemption();
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	polaris_note("S4", avail_start, first_avail, 0);
+#endif
 }
