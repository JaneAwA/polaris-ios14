 fbcon_clear_row(uint32_t row)
@@ -966,25 +972,29 @@
  * POLARIS: paint one bring-up progress cell from C.
  *
  * start.s lays out the same 96x96 grid: slots 0-7 fill the first row, 8 and up
- * the second.  Writes go to the physical address, not through fbcon_base,
- * because they have to work from the first C instruction -- long before
- * pmap_init() makes ml_io_map() possible.  That only holds until arm_vm_init()
- * installs the kernel pmap and drops the identity mapping, so callers must be
- * above that point.
+ * the second.  The panel is addressed through fbcon_base when the console has
+ * one, so the same call works before pmap_init() (raw address), across the MMU
+ * switch (block mapping installed by arm_vm_init) and afterwards (ml_io_map).
  */
 void
 polaris_boot_mark(unsigned int slot, unsigned int colour)
 {
 	uint32_t x = (slot % 8u) * 100u;
 	uint32_t y = (slot / 8u) * 120u;
-	volatile uint32_t *line =
-	    (volatile uint32_t *)(FBCON_BASE + y * FBCON_STRIDE + x * 4);
+	volatile uint32_t *base = fbcon_base;
+	uint32_t words = fbcon_words;
+
+	if (base == NULL) {
+		base = (volatile uint32_t *)(uintptr_t)FBCON_BASE;
+		words = FBCON_STRIDE / 4;
+	}
+	volatile uint32_t *line = base + y * words + x;
 
 	for (uint32_t r = 0; r < 96; r++) {
 		for (uint32_t c = 0; c < 96; c++) {
 			line[c] = colour;
 		}
-		line += FBCON_STRIDE / 4;
+		line += words;
 	}
 	__asm__ volatile ("dsb sy" ::: "memory");
 }
@@ -1250,19 +1260,36 @@
 /*
  * POLARIS: stop writing to the panel before TTBR0 leaves the identity table.
  *
- * The early console reaches the framebuffer through the raw address, which
- * only start.s's table maps.  arm_vm_init() calls this just before it installs
- * the kernel pmap; serial_init() re-registers fbcon_base through ml_io_map()
- * later, and the cursor position survives, so nothing already printed is lost.
+ * Only needed when the console is still on the raw address.  When
+ * arm_vm_init() managed to install a kernel block mapping for the panel it
+ * calls polaris_console_rebind() first, and this becomes a no-op so the
+ * kernel keeps talking through the switch.
  */
 void
 polaris_console_suspend(void)
 {
-	if (fbcon_physical) {
+	if (fbcon_physical && !fbcon_kernel_mapped) {
 		fbcon_base = NULL;
 	}
 }
 
+/*
+ * POLARIS: continue on the block mapping arm_vm_init() installed.
+ *
+ * fbcon_physical stays set: the address is still the panel, not a page that
+ * ml_io_map() owns, so the later fbcon_init() call has to re-map it through
+ * the pmap and take over.  The cursor position survives that hand-off.
+ */
+void
+polaris_console_rebind(void *va)
+{
+	if (va == NULL) {
+		return;
+	}
+	fbcon_base = (volatile uint32_t *)va;
+	fbcon_kernel_mapped = 1;
+}
+
 #else /* !ARM64_BOARD_CONFIG_POLARIS */
 
 static void
