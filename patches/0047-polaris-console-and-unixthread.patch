+				 * POLARIS: there is no dyld here, and a static arm64
+				 * binary keeps its entry point in the thread state of
+				 * LC_UNIXTHREAD.  Only take the program counter from it:
+				 * the stack pointer in there is zero, and the stack is
+				 * the one the kernel maps.
+				 */
+				ret = polaris_unixthread_entry(
+				    (struct thread_command *) lcp,
+				    result);
+#else
 				ret = load_unixthread(
-					(struct thread_command *) lcp,
-					thread,
-					slide,
-					is_x86_64_compat_binary,
-					result);
+				    (struct thread_command *) lcp,
+				    thread,
+				    slide,
+				    is_x86_64_compat_binary,
+				    result);
+#endif /* ARM64_BOARD_CONFIG_POLARIS */
