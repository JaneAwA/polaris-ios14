diff --git a/osfmk/arm/pmap.h b/osfmk/arm/pmap.h
--- a/osfmk/arm/pmap.h
+++ b/osfmk/arm/pmap.h
@@ -193,7 +193,19 @@
  * This indicates (roughly) where there is free space for the VM
  * to use for the heap; this does not need to be precise.
  */
-#if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
+#if defined(ARM_LARGE_MEMORY) && defined(ARM64_BOARD_CONFIG_POLARIS)
+/*
+ * On a large-memory kernel the low globals sit at VM_MIN_KERNEL_ADDRESS and the
+ * whole first L1 slot (64 GB) is the static window: the kernel image, the V=P
+ * aliases and every table pmap_bootstrap() carves out of avail_start.  If the
+ * heap were left to start at the first hole kmem_init() creates (VM_MIN + 32 MB)
+ * it would grow into those V=P mappings a few tens of megabytes later and start
+ * overwriting page tables under its own feet.  Shipping ARM_LARGE_MEMORY devices
+ * never see this because they all define KTRR, which takes the branch below;
+ * lift the heap a full L1 slot the same way.
+ */
+#define KERNEL_PMAP_HEAP_RANGE_START (VM_MIN_KERNEL_AND_KEXT_ADDRESS+ARM_TT_L1_SIZE)
+#elif defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
 #if defined(ARM_LARGE_MEMORY)
 #define KERNEL_PMAP_HEAP_RANGE_START (VM_MIN_KERNEL_AND_KEXT_ADDRESS+ARM_TT_L1_SIZE)
 #else // ARM_LARGE_MEMORY
diff --git a/osfmk/arm/pmap.c b/osfmk/arm/pmap.c
--- a/osfmk/arm/pmap.c
+++ b/osfmk/arm/pmap.c
@@ -5100,7 +5100,18 @@
 #endif
 
 	if (region_select == 0) {
-#if     (__ARM_VMSA__ == 7)
+#if defined(ARM64_BOARD_CONFIG_POLARIS) && defined(ARM_LARGE_MEMORY)
+		/*
+		 * With ARM_LARGE_MEMORY the low globals, the kernel image and the
+		 * V=P aliases of everything pmap_bootstrap() carves out of
+		 * avail_start share the first L1 slot, so the whole slot has to be
+		 * kept away from the VM.  That is the same region the KTRR branch
+		 * above reserves, and it is what keeps the heap from being placed
+		 * on top of the page tables and the vm_page array.
+		 */
+		*startp = LOW_GLOBAL_BASE_ADDRESS & ~ARM_TT_L2_OFFMASK;
+		*size = ((KERNEL_PMAP_HEAP_RANGE_START - *startp) & ~PAGE_MASK);
+#elif   (__ARM_VMSA__ == 7)
 		*startp = gVirtBase & 0xFFC00000;
 		*size = ((virtual_space_start - (gVirtBase & 0xFFC00000)) + ~0xFFC00000) & 0xFFC00000;
 #else
@@ -5121,6 +5132,14 @@
 		ret = TRUE;
 	}
 #if     (__ARM_VMSA__ > 7)
+#if defined(ARM64_BOARD_CONFIG_POLARIS) && defined(ARM_LARGE_MEMORY)
+	/*
+	 * Region 0 above already covers the low globals and everything else in
+	 * the static window, so regions 2 and 3 would only overlap it.  Region 3
+	 * would in fact be empty (VM_MIN_KERNEL_ADDRESS == LOW_GLOBAL_BASE_ADDRESS
+	 * here) and a zero length region makes kmem_init() panic.
+	 */
+#else
 	/* We need to reserve a range that is at least the size of an L2 block mapping for the low globals */
 	if (!TEST_PAGE_SIZE_4K) {
 		low_global_vr_mask = 0xFFFFFFFFFE000000;
@@ -5144,8 +5163,24 @@
 		*size = LOW_GLOBAL_BASE_ADDRESS - *startp;
 		ret = TRUE;
 	}
+#endif /* POLARIS && ARM_LARGE_MEMORY */
 #endif
 #endif
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	/*
+	 * kmem_init() feeds every region straight to vm_map_enter(), which rejects
+	 * a zero length request with KERN_INVALID_ARGUMENT and panics on the spot:
+	 *
+	 *   kmem_init(0xfffffe0009084000,0xfffffe8fffffc000):
+	 *       vm_map_enter(0xfffffe0000000000,0x0) error 0x4
+	 *
+	 * That is what region 3 used to do on this board.  It is compiled out
+	 * above, but never hand kmem_init() an empty range from here either.
+	 */
+	if (ret && *size == 0) {
+		ret = FALSE;
+	}
+#endif /* ARM64_BOARD_CONFIG_POLARIS */
 	return ret;
 }
 
