+	lsr		x11, x11, #(ARM_TT_L2_SHIFT)
+	lsl		x11, x11, #(TTE_SHIFT)
+	add		x9, x9, x11			// L2 slot for 0x9d400000
+	MOV64	x13, (0x40d)			// valid | AF | attrindx 3 (device)
+	orr		x10, x10, x13
+	str		x10, [x9]			// 32 MB block, the panel needs 8.9
+2:
 
 	/* Ensure TTEs are visible */
 	dsb		ish
@@ -868,16 +901,14 @@
 	MSR_SCTLR_EL1_X0
