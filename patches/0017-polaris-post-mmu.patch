+	/*
+	 * Keep the splash framebuffer addressable once the MMU is on.
+	 *
+	 * The bootstrap tables only cover [phys_base, phys_base + mem_size), and
+	 * on this board that begins at 4 GB while the panel sits at 0x9d400000.
+	 * Every mark below, and the fault reporter itself, writes that address;
+	 * without an entry of their own they take a translation fault the moment
+	 * SCTLR.M is set, and a fault taken by the code whose only job is to
+	 * report faults is silent -- indistinguishable from a hang.
+	 *
+	 * Pages are 16 KB here, so one L1 slot spans 64 GB and one L2 block spans
+	 * 32 MB.  VA 0x9d400000 therefore shares L1[0] with the V=P mapping that
+	 * starts at phys_base, which already has an L2 table hanging off it; the
+	 * slot for 0x9d400000 (L2 index 78) sits below the V=P entries at 128+,
+	 * so the panel can be described by a single block in that table, with no
+	 * extra page and no cache maintenance (device memory is uncached).
+	 */
+	MOV64	x10, (0x9d400000)
+	and		x12, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L1_SHIFT)
+	lsl		x12, x12, #(TTE_SHIFT)
