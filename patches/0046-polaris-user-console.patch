 /*
+ * mockfs_write:
+ *   The image is read-only, with one exception: /dev/console.  Writing to
+ *   it prints the bytes on the panel.  That is the only way for user space
+ *   to talk to us, so it is worth having before anything else.
+ *
+ * Returns 0 on success, or an error.
+ */
+int
+mockfs_write(struct vnop_write_args * ap)
+{
+	vnode_t vp;
+	mockfs_fsnode_t fsnode;
+	struct uio * uio;
+	char * buf;
+	size_t len;
+	int error;
+
+	vp = ap->a_vp;
+	fsnode = (mockfs_fsnode_t) vnode_fsnode(vp);
+	uio = ap->a_uio;
+
+	if (!fsnode || fsnode->type != MOCKFS_CONSOLE) {
+		return EROFS;
+	}
+
+	len = (size_t)uio_resid(uio);
+	if (len == 0) {
+		return 0;
+	}
+	if (len > 1024) {
+		len = 1024;
+	}
+
+	buf = kalloc(len);
+	if (!buf) {
+		return ENOMEM;
+	}
+
+	/* For a write uio, uiomove() copies from the user buffer to us. */
+	error = uiomove(buf, (int)len, uio);
+	if (error == 0) {
+		polaris_write(buf, len);
+	}
+	kfree(buf, len);
+
+	return error;
+}
