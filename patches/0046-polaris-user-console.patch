+		} else if (lc->cmd == LC_UNIXTHREAD) {
+			/*
+			 * A statically linked arm64 binary usually carries its
+			 * entry point in the thread state of LC_UNIXTHREAD, and
+			 * the kernel has already picked it up (load_unixthread
+			 * knows about ARM_THREAD_STATE64).  Nothing to compute
+			 * here, but do not fail either.
