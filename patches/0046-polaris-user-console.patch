 /*
+ * POLARIS: user space writes to /dev/console end up here.  The panel is the
+ * only console this board has, so the bytes are drawn straight on it; that
+ * is the whole user-space-to-kernel channel for now.
+ */
+void
+polaris_write(const char *buf, size_t len)
+{
+	size_t i;
+
+	if (fbcon_base == NULL) {
+		return;
+	}
+	for (i = 0; i < len; i++) {
+		fbcon_draw(buf[i]);
+	}
+}
