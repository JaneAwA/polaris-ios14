+
+static const uint32_t polaris_iv256[8] = {
+	0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+	0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
+};
+
+static const uint64_t polaris_iv512[8] = {
+	0x6a09e667f3bcc908, 0xbb67ae8584caa73b,
+	0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
+	0x510e527fade682d1, 0x9b05688c2b3e6c1f,
+	0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
+};
+
+static const uint64_t polaris_iv384[8] = {
+	0xcbbb9d5dc1059ed8, 0x629a292a367cd507,
+	0x9159015a3070dd17, 0x152fecd8f70e5939,
+	0x67332667ffc00b31, 0x8eb44a8768581511,
+	0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4,
+};
+
+static void
+polaris_sha256_block(uint32_t h[8], const uint8_t *p)
+{
+	uint32_t w[64];
+	uint32_t a, b, c, d, e, f, g, hh, t1, t2;
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		w[i] = ((uint32_t)p[i * 4] << 24) | ((uint32_t)p[i * 4 + 1] << 16) |
+		    ((uint32_t)p[i * 4 + 2] << 8) | (uint32_t)p[i * 4 + 3];
+	}
+	for (i = 16; i < 64; i++) {
+		uint32_t s0 = PROTR32(w[i - 15], 7) ^ PROTR32(w[i - 15], 18) ^ (w[i - 15] >> 3);
+		uint32_t s1 = PROTR32(w[i - 2], 17) ^ PROTR32(w[i - 2], 19) ^ (w[i - 2] >> 10);
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+
+	a = h[0]; b = h[1]; c = h[2]; d = h[3];
+	e = h[4]; f = h[5]; g = h[6]; hh = h[7];
+
+	for (i = 0; i < 64; i++) {
+		uint32_t bsig1 = PROTR32(e, 6) ^ PROTR32(e, 11) ^ PROTR32(e, 25);
+		uint32_t ch = (e & f) ^ (~e & g);
+		uint32_t bsig0 = PROTR32(a, 2) ^ PROTR32(a, 13) ^ PROTR32(a, 22);
+		uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+
+		t1 = hh + bsig1 + ch + polaris_k256[i] + w[i];
+		t2 = bsig0 + maj;
+		hh = g; g = f; f = e; e = d + t1;
+		d = c; c = b; b = a; a = t1 + t2;
+	}
+
+	h[0] += a; h[1] += b; h[2] += c; h[3] += d;
+	h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+}
+
+static void
+polaris_sha512_block(uint64_t h[8], const uint8_t *p)
+{
+	uint64_t w[80];
+	uint64_t a, b, c, d, e, f, g, hh, t1, t2;
+	int i, j;
+
+	for (i = 0; i < 16; i++) {
+		w[i] = 0;
+		for (j = 0; j < 8; j++) {
+			w[i] = (w[i] << 8) | (uint64_t)p[i * 8 + j];
+		}
+	}
+	for (i = 16; i < 80; i++) {
+		uint64_t s0 = PROTR64(w[i - 15], 1) ^ PROTR64(w[i - 15], 8) ^ (w[i - 15] >> 7);
+		uint64_t s1 = PROTR64(w[i - 2], 19) ^ PROTR64(w[i - 2], 61) ^ (w[i - 2] >> 6);
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+
+	a = h[0]; b = h[1]; c = h[2]; d = h[3];
+	e = h[4]; f = h[5]; g = h[6]; hh = h[7];
+
+	for (i = 0; i < 80; i++) {
+		uint64_t bsig1 = PROTR64(e, 14) ^ PROTR64(e, 18) ^ PROTR64(e, 41);
+		uint64_t ch = (e & f) ^ (~e & g);
+		uint64_t bsig0 = PROTR64(a, 28) ^ PROTR64(a, 34) ^ PROTR64(a, 39);
+		uint64_t maj = (a & b) ^ (a & c) ^ (b & c);
+
+		t1 = hh + bsig1 + ch + polaris_k512[i] + w[i];
+		t2 = bsig0 + maj;
+		hh = g; g = f; f = e; e = d + t1;
+		d = c; c = b; b = a; a = t1 + t2;
+	}
+
+	h[0] += a; h[1] += b; h[2] += c; h[3] += d;
+	h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+}
+
+static void
+_polaris_sha256_update(struct polaris_sha256_state *s, const void *data, size_t len)
+{
+	const uint8_t *p = (const uint8_t *)data;
+
+	s->nbytes += len;
+	while (len > 0) {
+		uint32_t n;
+		if (s->used == 0 && len >= 64) {
+			polaris_sha256_block(s->h, p);
+			p += 64;
+			len -= 64;
+			continue;
+		}
+		n = 64 - s->used;
+		if ((size_t)n > len) {
+			n = (uint32_t)len;
+		}
+		memcpy(s->buf + s->used, p, n);
+		s->used += n;
+		p += n;
+		len -= n;
+		if (s->used == 64) {
+			polaris_sha256_block(s->h, s->buf);
+			s->used = 0;
+		}
+	}
+}
+
+static void
+_polaris_sha512_update(struct polaris_sha512_state *s, const void *data, size_t len)
+{
+	const uint8_t *p = (const uint8_t *)data;
+
+	s->nbytes += len;
+	while (len > 0) {
+		uint32_t n;
+		if (s->used == 0 && len >= 128) {
+			polaris_sha512_block(s->h, p);
+			p += 128;
+			len -= 128;
+			continue;
+		}
+		n = 128 - s->used;
+		if ((size_t)n > len) {
+			n = (uint32_t)len;
+		}
+		memcpy(s->buf + s->used, p, n);
+		s->used += n;
+		p += n;
+		len -= n;
+		if (s->used == 128) {
+			polaris_sha512_block(s->h, s->buf);
+			s->used = 0;
+		}
+	}
+}
+
+static void
+_polaris_sha256_final(uint8_t out[32], struct polaris_sha256_state *s)
+{
+	uint64_t bits = s->nbytes << 3;
+	uint32_t i = s->used;
+	int j;
+
+	s->buf[i++] = 0x80;
+	if (i > 56) {
+		while (i < 64) {
+			s->buf[i++] = 0;
+		}
+		polaris_sha256_block(s->h, s->buf);
+		i = 0;
+	}
+	while (i < 56) {
+		s->buf[i++] = 0;
+	}
+	for (j = 0; j < 8; j++) {
+		s->buf[56 + j] = (uint8_t)(bits >> (56 - 8 * j));
+	}
+	polaris_sha256_block(s->h, s->buf);
+
+	for (j = 0; j < 8; j++) {
+		out[j * 4] = (uint8_t)(s->h[j] >> 24);
+		out[j * 4 + 1] = (uint8_t)(s->h[j] >> 16);
+		out[j * 4 + 2] = (uint8_t)(s->h[j] >> 8);
+		out[j * 4 + 3] = (uint8_t)s->h[j];
+	}
+}
+
+static void
+_polaris_sha512_final(uint8_t out[64], struct polaris_sha512_state *s)
+{
+	uint64_t bits = s->nbytes << 3;
+	uint32_t i = s->used;
+	int j;
+
+	s->buf[i++] = 0x80;
+	if (i > 112) {
+		while (i < 128) {
+			s->buf[i++] = 0;
+		}
+		polaris_sha512_block(s->h, s->buf);
+		i = 0;
+	}
+	/* 128 bit length field: the high half is zero, the low half is the
+	 * bit count, so the message is padded to byte 120, not 112. */
+	while (i < 120) {
+		s->buf[i++] = 0;
+	}
+	for (j = 0; j < 8; j++) {
+		s->buf[120 + j] = (uint8_t)(bits >> (56 - 8 * j));
+	}
+	polaris_sha512_block(s->h, s->buf);
+
+	for (j = 0; j < 8; j++) {
+		int k;
+		for (k = 0; k < 8; k++) {
+			out[j * 8 + k] = (uint8_t)(s->h[j] >> (56 - 8 * k));
+		}
+	}
+}
+
+void
+polaris_sha256_init(void *ctx)
+{
+	struct polaris_sha256_state *s = (struct polaris_sha256_state *)ctx;
+	int i;
+
+	for (i = 0; i < 8; i++) {
+		s->h[i] = polaris_iv256[i];
+	}
+	s->nbytes = 0;
+	s->used = 0;
+}
+
+void
+polaris_sha256_update(void *ctx, const void *data, size_t len)
+{
+	_polaris_sha256_update((struct polaris_sha256_state *)ctx, data, len);
+}
+
+void
+polaris_sha256_final(void *out, void *ctx)
+{
+	_polaris_sha256_final((uint8_t *)out, (struct polaris_sha256_state *)ctx);
+}
+
+static void
+polaris_sha512_start(struct polaris_sha512_state *s, const uint64_t iv[8])
+{
+	int i;
+	for (i = 0; i < 8; i++) {
+		s->h[i] = iv[i];
+	}
+	s->nbytes = 0;
+	s->used = 0;
+}
+
+void
+polaris_sha512_init(void *ctx)
+{
+	polaris_sha512_start((struct polaris_sha512_state *)ctx, polaris_iv512);
+}
+
+void
+polaris_sha384_init(void *ctx)
+{
+	polaris_sha512_start((struct polaris_sha512_state *)ctx, polaris_iv384);
+}
+
+void
+polaris_sha512_update(void *ctx, const void *data, size_t len)
+{
+	_polaris_sha512_update((struct polaris_sha512_state *)ctx, data, len);
+}
+
+void
+polaris_sha512_final(void *out, void *ctx)
+{
+	_polaris_sha512_final((uint8_t *)out, (struct polaris_sha512_state *)ctx);
+}
+
+void
+polaris_sha384_final(void *out, void *ctx)
+{
+	uint8_t tmp[64];
+
+	_polaris_sha512_final(tmp, (struct polaris_sha512_state *)ctx);
+	memcpy(out, tmp, 48);
+}
+
+void
+polaris_sha384_update(void *ctx, const void *data, size_t len)
+{
+	_polaris_sha512_update((struct polaris_sha512_state *)ctx, data, len);
+}
+
+/*
+ * POLARIS: there is no corecrypto kext on this board, so g_crypto_funcs is
+ * NULL and every wrapper above would fault on its very first load.  Serve the
+ * digests from the scalar implementation instead.  The opaque buffer that
+ * ccdigest_ctx_decl() hands us is 112 bytes for SHA-256 and 208 for
+ * SHA-512/384, which is exactly what our own state structs occupy.
+ */
+void
+SHA256_Init(SHA256_CTX *ctx)
+{
+	polaris_sha256_init((void *)ctx->ctx);
+}
+
+void
+SHA256_Update(SHA256_CTX *ctx, const void *data, size_t len)
+{
+	polaris_sha256_update((void *)ctx->ctx, data, len);
+}
+
+void
+SHA256_Final(void *digest, SHA256_CTX *ctx)
+{
+	polaris_sha256_final(digest, (void *)ctx->ctx);
+}
+
+void
+SHA384_Init(SHA384_CTX *ctx)
+{
+	polaris_sha384_init((void *)ctx->ctx);
+}
+
+void
+SHA384_Update(SHA384_CTX *ctx, const void *data, size_t len)
+{
+	polaris_sha384_update((void *)ctx->ctx, data, len);
+}
+
+void
+SHA384_Final(void *digest, SHA384_CTX *ctx)
+{
+	polaris_sha384_final(digest, (void *)ctx->ctx);
+}
+
+void
+SHA512_Init(SHA512_CTX *ctx)
+{
+	polaris_sha512_init((void *)ctx->ctx);
+}
+
+void
+SHA512_Update(SHA512_CTX *ctx, const void *data, size_t len)
+{
+	polaris_sha512_update((void *)ctx->ctx, data, len);
+}
+
+void
+SHA512_Final(void *digest, SHA512_CTX *ctx)
+{
+	polaris_sha512_final(digest, (void *)ctx->ctx);
+}
