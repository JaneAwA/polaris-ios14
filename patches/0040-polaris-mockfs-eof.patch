diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -427,8 +427,14 @@
  * Page aligned on purpose: this array *is* the md0 device, and memdev
  * addresses a memory device by page number, so a misaligned array would
  * shift every read by the offset inside the page.
+ *
+ * The Mach-O is 2 KB, but the device is 16 KB: UBC reads the 32 byte header
+ * in whole clusters, and a device that is smaller than one cluster makes the
+ * very first read run off the end.  The tail is zero filled by the compiler,
+ * and the Mach-O header still describes exactly the segments it described
+ * before.
  */
-static const unsigned char polaris_root_image[2048]
+static const unsigned char polaris_root_image[16384]
     __attribute__((aligned(4096), used)) = {
 	0xcf, 0xfa, 0xed, 0xfe, 0x0c, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00,
 	0x02, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0xf8, 0x00, 0x00, 0x00,
@@ -1140,7 +1146,7 @@
 	 * memdev takes the base as a page number and, with phys == 0, treats it as
 	 * a kernel virtual address, which is exactly what we have: mockfs reads
 	 * through cluster_read -> strategy -> mdevstrategy, which bcopy()s straight
-	 * out of the kernel image.  One page is enough for the whole Mach-O.
+	 * out of the kernel image.
 	 */
 	{
 		dev_t polaris_md = mdevadd(0,
