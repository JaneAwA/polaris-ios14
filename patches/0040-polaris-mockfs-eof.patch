+		*run = (size_t)(fsnode->size - (uint64_t)foffset);
+		if (ap->a_size > *run && polaris_blockmap_notes < 4) {
+			polaris_blockmap_notes++;
+			polaris_note("MB", (uint64_t)foffset, (uint64_t)ap->a_size,
+			    fsnode->size);
 		}
