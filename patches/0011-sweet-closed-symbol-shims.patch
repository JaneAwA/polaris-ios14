 #  symbols (every pmap_*, Switch_context, kvtophys, ads_zone, ...).
 #
-#  `pgo` joins BSD_RELEASE for the same reason. libkern/c++/OSKext.cpp calls
-#  __llvm_profile_get_size_for_buffer_internal() and
-#  __llvm_profile_write_buffer_internal() unconditionally, and Apple resolves
-#  those from the profiling runtime inside libcc_kext.a. The equivalent source
-#  ships in this tree at bsd/pgo/profile_runtime.c but is `optional pgo`, so
-#  without this attribute it is not compiled and the link fails. dev/debug
-#  configurations already carry the attribute; release simply never needed it
-#  on a platform that links cc_kext.
+#  The three BSD attributes below exist because this kernel is built with
+#  PLATFORM=MacOSX (the SDK we have), so MASTER's macOS RELEASE list -- not the
+#  iOS one -- is what gets applied. Each attribute compiles a file that macOS
+#  leaves out but whose symbols Apple's own arm64 export lists still demand:
+#
+#      quota                     bsd/vfs/vfs_quota.c   -> dqfileinit/dqget/qf_get/...
+#      config_csr                bsd/kern/kern_csr.c   -> csr_check
+#      config_user_notification  osfmk/UserNotification/KUNCUserNotifications.c -> KUNC*
+#
+#  Note that `pgo` deliberately does not appear here. bsd/pgo/profile_runtime.c
+#  only declares the two __llvm_profile_*_internal entry points; their bodies
+#  live in compiler-rt and reach Apple's kernel through libcc_kext.a, so
+#  compiling that file changes nothing. osfmk/arm64/polaris_shims.c supplies
+#  them instead, alongside the other three symbols whose only implementation is
+#  in a closed Apple component.
 #
 ######################################################################
 #
