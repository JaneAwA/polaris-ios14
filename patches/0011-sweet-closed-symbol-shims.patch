+ * http://www.opensource.apple.com/apsl/ and read it before using this file.
+ *
+ * The Original Code and all software distributed under the License are
+ * distributed on an 'AS IS' basis, WITHOUT WARRANTY OF ANY KIND, EITHER
+ * EXPRESS OR IMPLIED, AND APPLE HEREBY DISCLAIMS ALL SUCH WARRANTIES,
+ * INCLUDING WITHOUT LIMITATION, ANY WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE, QUIET ENJOYMENT OR NON-INFRINGEMENT.
+ * Please see the License for the specific language governing rights and
+ * limitations under the License.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+
+/*
+ * Symbols the open kernel references but does not contain.
+ *
+ * Once the open arm64 pmap and asm were switched on (0008) and the closed
+ * export-list entries pruned (0009, 0011), the arm64 link came down to four
+ * symbols that no shipped source defines, plus one bsd syscall whose body is
+ * compiled out on a macOS-flavoured build. None of them is reachable during
+ * early boot; each one exists so that the kernel can be linked and run at all.
+ *
+ *   ml_enable_monitor()      arm_vm_init.c:2018 calls it unconditionally. On
+ *                            Apple silicon it flips the PPL monitor on; this
+ *                            port builds with XNU_MONITOR=0, so the correct
+ *                            behaviour on a non-Apple SoC is to do nothing.
+ *
+ *   pmap_cs_allow_invalid()  vm_map.c:20183 for the cs_allow_invalid debug
+ *                            knob. The x86 pmap answers KERN_SUCCESS with the
+ *                            comment "Unsupported on this architecture", which
+ *                            is exactly this situation.
+ *
+ *   pid_hibernate()          The freezer syscall. Its only definition sits in
+ *                            bsd/vm/vm_unix.c behind #if !XNU_TARGET_OS_OSX,
+ *                            and this build is PLATFORM=MacOSX because that is
+ *                            the SDK available, so sysent refers to a symbol
+ *                            that is never compiled. Returning ENOSYS keeps
+ *                            the syscall table consistent.
+ *
+ *   __llvm_profile_*()       libkern/c++/OSKext.cpp calls both from
+ *                            OSKextGrabPgoDataLocked(). Their bodies live in
+ *                            compiler-rt and reach Apple's kernel through
+ *                            libcc_kext.a; bsd/pgo/profile_runtime.c only
+ *                            declares them. A kernel that is not built with
+ *                            -fprofile-instr-generate has no counters, so a
+ *                            zero size and a no-op write are the truthful
+ *                            answers and make kext PGO extraction report
+ *                            "nothing to hand over" instead of panicking.
+ */
+
+#include <mach/mach_types.h>
+#include <kern/kern_types.h>
+#include <sys/errno.h>
+#include <arm/machine_routines.h>
+#include <vm/pmap.h>
+
+struct proc;
+struct pid_hibernate_args;
+
+void
+ml_enable_monitor(void)
+{
+}
+
+kern_return_t
+pmap_cs_allow_invalid(__unused pmap_t pmap)
+{
+	return KERN_SUCCESS;
+}
+
+int
+pid_hibernate(struct proc *p __unused, struct pid_hibernate_args *args __unused,
+    int *ret)
+{
+	if (ret != NULL) {
+		*ret = ENOSYS;
+	}
+	return ENOSYS;
+}
+
+uint64_t
+__llvm_profile_get_size_for_buffer_internal(const char *data_begin __unused,
+    const char *data_end __unused,
+    const char *counters_begin __unused,
+    const char *counters_end __unused,
+    const char *names_begin __unused,
+    const char *names_end __unused)
+{
+	return 0;
+}
+
+int
+__llvm_profile_write_buffer_internal(char *buffer __unused,
+    const char *data_begin __unused,
+    const char *data_end __unused,
+    const char *counters_begin __unused,
+    const char *counters_end __unused,
+    const char *names_begin __unused,
+    const char *names_end __unused)
+{
+	return 0;
+}
