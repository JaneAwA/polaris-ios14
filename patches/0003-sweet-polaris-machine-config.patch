diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 31d5c8e..bd3251b 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1759,6 +1759,43 @@ sleh_irq(arm_saved_state_t *state)
 #endif
 
 
+#if defined(POLARIS)
+	/*
+	 * SDM845: TrustZone owns GIC Group 0, so the virtual timer and the IPIs
+	 * arrive here as Group 1 IRQs instead of as FIQs.
+	 */
+	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
+
+	if (intid >= 1020 && intid <= 1023) {
+		return; /* spurious: reading IAR1 did not acknowledge anything */
+	}
+
+	if (intid == POLARIS_VTIMER_INTID) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
+		cdp->cpu_decrementer = -1; /* Large */
+		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
+		rtclock_intr(TRUE);
+		INTERRUPT_MASKED_DEBUG_END();
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	} else if (intid < 16) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
+		/* Ack before handling so an IPI raised meanwhile is not lost */
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		__builtin_arm_isb(ISB_SY);
+		cpu_signal_handler();
+	} else {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
+		if (cdp->interrupt_handler) {
+			cdp->interrupt_handler(cdp->interrupt_target,
+			    cdp->interrupt_refCon,
+			    cdp->interrupt_nub,
+			    intid);
+		}
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	}
+	__builtin_arm_isb(ISB_SY);
+#else /* !POLARIS */
 	sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
 
 #if USE_APPLEARMSMP
@@ -1770,6 +1807,7 @@ sleh_irq(arm_saved_state_t *state)
 	    cdp->interrupt_nub,
 	    cdp->interrupt_source);
 #endif
+#endif /* POLARIS */
 
 	entropy_collect();
 
