+#endif /* !POLARIS: firmware owns SCTLR, nothing to compare against */
 
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
 	/* Watchtower
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 5d9d5e1..2543fd6 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -143,11 +143,26 @@ pe_init_fiq()
 		}
 	}
 
+#if defined(POLARIS)
+	/*
+	 * Real hardware with two security states: Group 0 belongs to TrustZone
+	 * and non-secure writes to it are ignored. Everything we own is Group 1
+	 * NS and arrives as an IRQ (see sleh_irq). GICR_IGROUPR0 reads back as
+	 * zero from the non-secure side even after this write; delivery still
+	 * works.
+	 */
+	gicr_write32(GICR_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicr_write32(GICR_ISENABLER0, (1U << POLARIS_VTIMER_INTID) | (1U << POLARIS_IPI_SGI));
+#else
 	// Configure timers and legacy FIQ to be group 0
 	gicr_write32(GICR_IGROUPR0, 0x81FFFFFF);
 
 	// Enable PPI 27
 	gicr_write32(GICR_ISENABLER0, (1 << 27));
+#endif /* POLARIS */
 
 	// Enable system register access
 	uint64_t icc_sre = __builtin_arm_rsr64("ICC_SRE_EL1");
@@ -155,8 +170,13 @@ pe_init_fiq()
 	__builtin_arm_wsr64("ICC_SRE_EL1", icc_sre);
 	__builtin_arm_isb(ISB_SY);
 
+#if defined(POLARIS)
+	/* Group 1 lives behind BPR1, not BPR0 */
+	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
+#else
 	// Set priority masks and binary point for group 0
 	__builtin_arm_wsr64("ICC_BPR0_EL1", 0);
+#endif /* POLARIS */
 	__builtin_arm_wsr64("ICC_PMR_EL1", 0xFF);
 
 	// Set EOI mode of this processor
@@ -164,12 +184,24 @@ pe_init_fiq()
 	icc_ctlr &= ~ICC_CTLR_EOIMODE;
 	__builtin_arm_wsr64("ICC_CTLR_EL1", icc_ctlr);
 
+#if defined(POLARIS)
+	// ABL leaves only ARE_NS set; enable Group 1 the way Linux does
+	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
+	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
+	gicd_write32(GICD_CTLR, gicd_ctlr);
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
+	__builtin_arm_isb(ISB_SY);
+#else
 	// Enable the forwarding of the vtimer interrupt
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
 	gicd_ctlr |= GICD_CTLR_ENABLEGRP0;
 	gicd_write32(GICD_CTLR, gicd_ctlr);
 	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 1);
 	__builtin_arm_isb(ISB_SY);
+#endif /* POLARIS */
 }
 #else
 void
