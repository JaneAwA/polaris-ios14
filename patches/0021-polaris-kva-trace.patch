diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -1032,6 +1032,29 @@
 	polaris_puts(&buf[i]);
 }
 
+/*
+ * POLARIS: one line of numbers from anywhere in the kernel, drawn straight on
+ * the panel.  Used while the pmap is still being built, where kprintf means
+ * taking the console lock and formatting floats of hex through _doprnt.
+ */
+void
+polaris_note(const char *tag, uint64_t a, uint64_t b, uint64_t c)
+{
+	if (fbcon_base == NULL) {
+		return;
+	}
+	polaris_puts("\nPOLARIS ");
+	while (*tag != '\0') {
+		fbcon_draw(*tag++);
+	}
+	polaris_puts(" ");
+	polaris_hex(a);
+	polaris_puts(" ");
+	polaris_hex(b);
+	polaris_puts(" ");
+	polaris_hex(c);
+}
+
 struct polaris_abort {
 	uint64_t far;
 	uint64_t esr;
