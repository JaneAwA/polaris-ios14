diff --git a/osfmk/arm64/polaris_shims.c b/osfmk/arm64/polaris_shims.c
index 3f4d21e..af83cf3 100644
--- a/osfmk/arm64/polaris_shims.c
+++ b/osfmk/arm64/polaris_shims.c
@@ -96,6 +96,16 @@ polaris_map_probe(vm_map_t map, uint64_t addr)
 	polaris_note("US", addr, start, end);
 	polaris_note("UP", prot, (uint64_t)(uintptr_t)map->pmap,
 	    (uint64_t)(uintptr_t)map);
+	/*
+	 * POLARIS: the range the pmap believes it covers.  pmap_vtophys() and
+	 * friends refuse every address outside [min, max), and pmap_enter()
+	 * quietly does nothing useful there, so an address that is inside the
+	 * map but outside the pmap looks exactly like a fault that the VM
+	 * keeps "succeeding" at.  ttep is the table the pmap owns; UY later
+	 * prints it again next to the one in TTBR0.
+	 */
+	polaris_note("UZ", (uint64_t)map->pmap->min, (uint64_t)map->pmap->max,
+	    (uint64_t)map->pmap->ttep);
 }
 
 struct proc;
