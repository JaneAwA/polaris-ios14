+				polaris_note("UG", (uint64_t)result, live,
+				    (uint64_t)pmap_find_phys(map->pmap, vm_fault_addr));
 			}
 			/*
 			 * UY answers the remaining question: is the page table the
@@ -1462,7 +1481,7 @@ handle_user_abort(arm_saved_state_t *state, uint32_t esr, vm_offset_t fault_addr
