diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -993,11 +993,16 @@
  * POLARIS: report an early abort on the panel.
  *
  * A data abort from EL1 reaches handle_abort() before anything else looks at
- * it, and on this port that path can end inside vm_fault(), which dies on
- * current_task() because kernel_task does not exist yet.  Print the abort
- * itself -- address, syndrome, pc and the caller chain -- while the console
- * still works, so the fault that started it is not lost.  Capped, because a
- * repeating fault would otherwise paint the screen forever.
+ * it, and on this port that path ends inside vm_fault(), which dies on
+ * current_task() -- init_thread.task is still NULL until the bootstrap thread
+ * is created, so &task->faults is a read of address 0x368.  That fault is
+ * itself an abort, so the handler re-enters and the exception stack fills up
+ * with copies of the same report until it overflows and the real first fault
+ * has long scrolled off the top of the panel.
+ *
+ * So: keep the first abort's numbers, print them again under every later
+ * report, and stop the machine on the first abort that has no task -- there
+ * is nothing downstream that could survive it.
  */
 static void
 polaris_puts(const char *s)
@@ -1007,6 +1012,11 @@
 	}
 }
 
+/*
+ * Minimal-width hex.  These lines have to stay inside the panel's ~55
+ * columns, and padding every value to sixteen digits costs more than the
+ * whole rest of the line.
+ */
 static void
 polaris_hex(uint64_t v)
 {
@@ -1018,51 +1028,96 @@
 		int d = (int)(v & 0xfu);
 		buf[--i] = (char)(d < 10 ? '0' + d : 'a' + d - 10);
 		v >>= 4;
-	} while (v != 0 && i > 0);
-	while (i > 0) {
-		buf[--i] = '0';
-	}
+	} while (v != 0);
 	polaris_puts(&buf[i]);
 }
 
+struct polaris_abort {
+	uint64_t far;
+	uint64_t esr;
+	uint64_t pc;
+	uint64_t lr;
+	int      valid;
+};
+
+static struct polaris_abort polaris_first_abort;
+static int polaris_abort_count;
+
+static void
+polaris_print_first_abort(void)
+{
+	if (!polaris_first_abort.valid) {
+		return;
+	}
+	polaris_puts("\nPOLARIS #1 far=");
+	polaris_hex(polaris_first_abort.far);
+	polaris_puts(" esr=");
+	polaris_hex(polaris_first_abort.esr);
+	polaris_puts("\nPOLARIS #1 pc=");
+	polaris_hex(polaris_first_abort.pc);
+	polaris_puts(" lr=");
+	polaris_hex(polaris_first_abort.lr);
+}
