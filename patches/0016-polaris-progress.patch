 /*
+ * POLARIS bring-up progress marks.
+ *
+ * SDM845 has no debug UART, nothing is cached this early, and the loader
+ * hands over with the MMU off, so every address reached from here is
+ * physical.  The only observable is the splash framebuffer.  Each mark
+ * paints one 96x96 cell at x = idx*100, y = 0..95, so a photo of the screen
+ * shows exactly how far the kernel got: count the cells.
+ *
+ *  0 entry            4 SP_EL0 + lr = arm_init
+ *  1 OSLAR/DAIF/mov   5 mach header read, bases adjusted
+ *  2 boot_args loaded 6 V=P bootstrap map built
+ *  3 SP_EL1 set       7 KVA bootstrap map built
+ */
+.macro POLARIS_MARK
+	MOV64	x9, (0x9d400000 + (($0) * 400))
+	MOV64	x10, ($1)
+	mov	x11, #96
+9990:	mov	x12, #96
+9991:	str	w10, [x9], #4
+	subs	x12, x12, #1
+	b.ne	9991b
+	add	x9, x9, #(4320 - 384)
+	subs	x11, x11, #1
+	b.ne	9990b
+	dsb	sy
+.endm
+
+/*
  * __start trampoline is located at a position relative to LowResetVectorBase
  * so that iBoot can compute the reset vector position to set IORVBAR using
  * only the kernel entry point.  Reset vector = (__start & ~0xfff)
