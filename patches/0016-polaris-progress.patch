+/*
+ * POLARIS early fault reporter.
+ *
+ * The 16 slots above were 'b .', which is indistinguishable from a hang: the
+ * CPU just stops, with ELR_EL1 holding the faulting PC and no way to read it.
+ * Paint instead, then park.  This only works while the MMU is off, where every
+ * address is physical and the framebuffer is directly writable; a fault after
+ * the MMU switch lands here too, faults again, and parks the same way.
+ *
+ * Screen layout, y in pixels:
+ *   150..469  black band
+ *   150..173  white line            -> a fault happened
+ *   200..263  bar, 16 px per unit   -> ESR_EL1[31:26], the exception class
+ *   300..363  bar,  4 px per unit   -> ELR_EL1[11:4], the faulting PC
+ *                                      (page-relative, 16-byte granularity)
+ */
+Lpolaris_fault:
+	mrs		x9, esr_el1
+	mrs		x10, elr_el1
+
+	/* Black band, so the bars never blend into a red or green screen. */
+	MOV64	x11, (0x9d400000 + 150 * 4320)
+	mov		x12, xzr
+	mov		x13, #320
+9990:	mov		x14, #270
+9991:	str		w12, [x11], #4
+	subs	x14, x14, #1
+	b.ne	9991b
+	subs	x13, x13, #1
+	b.ne	9990b
+
+	MOV64	x11, (0x9d400000 + 200 * 4320)
+	lsr		x13, x9, #26
+	and		x13, x13, #0x3f
+	lsl		x13, x13, #4
+	bl		Lpolaris_bar
+
+	MOV64	x11, (0x9d400000 + 300 * 4320)
+	lsr		x13, x10, #4
+	and		x13, x13, #0xff
+	lsl		x13, x13, #2
+	bl		Lpolaris_bar
+
+9993:	wfi
+	b		9993b
+
+/*
+ * x11 = first pixel of the bar, x13 = width in pixels (0..1020).
+ * Draws 64 rows of white and leaves x11 at the end of the last row.
+ * Uses lr, so it may only be called from Lpolaris_fault.
+ */
+Lpolaris_bar:
+	movz	w12, #0xffff
+	movk	w12, #0xffff, lsl #16
+	mov		x14, #64
+	lsl		x16, x13, #2
+	mov		x17, #4320
+	sub		x17, x17, x16
+	cbz		x13, 9997f
+9994:	mov		x15, x13
+9995:	str		w12, [x11], #4
+	subs	x15, x15, #1
+	b.ne	9995b
+	add		x11, x11, x17
+	subs	x14, x14, #1
+	b.ne	9994b
+9997:	ret
+
