diff --git a/osfmk/arm/pmap.c b/osfmk/arm/pmap.c
--- a/osfmk/arm/pmap.c
+++ b/osfmk/arm/pmap.c
@@ -5143,6 +5143,23 @@
 		*startp = VM_MIN_KERNEL_ADDRESS;
 		*size = LOW_GLOBAL_BASE_ADDRESS - *startp;
 		ret = TRUE;
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+		/*
+		 * ARM_LARGE_MEMORY places the low globals at VM_MIN_KERNEL_ADDRESS
+		 * itself, so the gap this region is meant to reserve is empty and
+		 * *size comes out zero.  kmem_init() feeds every region to
+		 * vm_map_enter(), which rejects a zero-length request with
+		 * KERN_INVALID_ARGUMENT and panics on the spot:
+		 *
+		 *   kmem_init(0xfffffe0009084000,0xfffffe8fffffc000):
+		 *       vm_map_enter(0xfffffe0000000000,0x0) error 0x4
+		 *
+		 * Nothing needs reserving here, so report the region as absent.
+		 */
+		if (*size == 0) {
+			ret = FALSE;
+		}
+#endif /* ARM64_BOARD_CONFIG_POLARIS */
 	}
 #endif
 #endif
