+			{
+				/*
+				 * POLARIS: AT succeeds for hello's .text but the
+				 * PAR page (0x108498000) sits one slot away from
+				 * the PTE's page (0x108490000), while the child's
+				 * stack agrees exactly.  That is what a page-size
+				 * mismatch looks like: the pmap indexes the table
+				 * with one granule and the MMU walks it with
+				 * another.  Print TCR_EL1 next to the pmap leaf
+				 * shift:
+				 *   TG0 (bits 15:14) 0b00 = 4K, 0b10 = 16K
+				 *   shift 12 = 4K, 14 = 16K
+				 */
+				static int polaris_tq_n;
+
+				if (polaris_tq_n < 6) {
+					uint64_t tcr;
+
+					__asm__ volatile("mrs %0, tcr_el1"
+					    : "=r"(tcr));
+
+					polaris_tq_n++;
+					polaris_note("TQ", tcr,
+					    (uint64_t)pt_attr_leaf_shift(
+						    pmap_get_pt_attr(pmap)), 0);
+				}
+			}
