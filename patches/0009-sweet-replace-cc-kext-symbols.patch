+/*
+ * ___chkstk_darwin
+ *
+ * Stack probe for large frames. clang emits a call to this from a function
+ * prologue when `sub sp, sp, #imm` would move sp by more than a page, so that
+ * every page in the new range is touched in order instead of striding over the
+ * guard page. It does *not* move sp; the caller does that itself once the
+ * range has been probed.
+ *
+ * Darwin arm64 convention (the same one libsystem_platform implements for user
+ * space, and the one clang emits against):
+ *
+ *      mov     x9, #frame_size        // bytes that are about to be allocated
+ *      bl      ___chkstk_darwin
+ *
+ * Clobbers x10 and x11 only. This implementation additionally leaves x9 intact
+ * -- libsystem_platform destroys it, which is legal because nothing may read it
+ * back -- so callers that re-use x9 for the final `sub sp, sp, x9` work
+ * unchanged.
+ *
+ * Why this file exists at all: Apple's kernel resolves the symbol from
+ * libcc_kext.a, which ships only inside a Kernel Debug Kit. Nothing in the open
+ * xnu tree provides it, so a build against the public SDK links everything and
+ * then dies with
+ *
+ *      "___chkstk_darwin", referenced from:
+ *          _kern_coredump_routine in processor_core.o
+ *          _exception_deliver in exception.o
+ *          _handle_kernel_breakpoint in sleh.o
+ *          ...
+ *
+ * Probing in 4 KiB steps is deliberate: it is what libsystem_platform does, and
+ * on this platform (16 KiB kernel pages) stepping at 4 KiB simply touches each
+ * page more than once, never fewer.
+ */
+
+	.text
+	.p2align 2
+	.globl	___chkstk_darwin
+___chkstk_darwin:
+	mov	x10, sp			// x10 walks down the range
+	mov	x11, x9			// x11 = bytes still unprobed
+1:
+	subs	x11, x11, #4096
+	b.lo	2f			// less than a page left
+	sub	x10, x10, #4096
+	ldr	xzr, [x10]		// touch, faulting on the guard page if we
+					// ran past the bottom of the stack
+	b	1b
+2:
+	add	x11, x11, #4096		// x11 is now 0..4095
+	sub	x10, x10, x11
+	ldr	xzr, [x10]		// touch the lowest address of the frame
+	ret
