+/*
+ * <arm64/tunables/tunables.s> does not exist in the open source drop. Apple
+ * generates it per SoC to apply MIDR-matched register tweaks very early in
+ * start.s (uncore HID/CYC/PMCR settings that only exist on Apple silicon).
+ * start.s uses exactly one thing from it:
+ *
+ *     APPLY_TUNABLES x12, x13
+ *
+ * which is an assembler macro invoked with space-separated arguments, not a cpp
+ * macro -- there are no parentheses. The real file's body is a sequence of
+ * mrs/msr pairs matched against the MIDR; on a non-Apple part there is nothing
+ * to match, so the body stays empty while the signature keeps start.s
+ * source-identical to Apple's.
+ */
+#ifndef __arm64_tunables_tunables_s__
+#define __arm64_tunables_tunables_s__
+
+	.macro APPLY_TUNABLES midr_reg, scratch_reg
+	.endmacro
+
+#endif /* __arm64_tunables_tunables_s__ */
