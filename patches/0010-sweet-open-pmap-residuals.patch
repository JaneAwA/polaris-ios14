index 9cd9436..3bc4399 100644
--- a/osfmk/arm/pmap.c
+++ b/osfmk/arm/pmap.c
@@ -672,6 +672,18 @@ static struct pmap_image4_trust_cache *pmap_image4_trust_caches MARK_AS_PMAP_DAT
 
 MARK_AS_PMAP_DATA SIMPLE_LOCK_DECLARE(pmap_loaded_trust_caches_lock, 0);
 
+/*
+ * The compilation-service CDHash and its lock are defined in the x86_64 pmap
+ * but not in the open arm64 one: Apple's arm64 build gets them from the closed
+ * pmap, so nothing in the shipped sources declares or defines them, yet
+ * pmap_set_compilation_service_cdhash_internal() and
+ * pmap_match_compilation_service_cdhash_internal() below use both. Nothing on
+ * this platform calls those two functions, so a zero-filled array and an
+ * ordinary simple lock reproduce the reference behaviour exactly.
+ */
+MARK_AS_PMAP_DATA SIMPLE_LOCK_DECLARE(pmap_compilation_service_cdhash_lock, 0);
+static uint8_t pmap_compilation_service_cdhash[CS_CDHASH_LEN] MARK_AS_PMAP_DATA = { 0 };
+
 
