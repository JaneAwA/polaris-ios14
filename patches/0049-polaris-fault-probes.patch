diff --git a/bsd/miscfs/mockfs/mockfs_vnops.c b/bsd/miscfs/mockfs/mockfs_vnops.c
index 53334db..8931490 100644
--- a/bsd/miscfs/mockfs/mockfs_vnops.c
+++ b/bsd/miscfs/mockfs/mockfs_vnops.c
@@ -459,11 +459,25 @@ int
 mockfs_pagein(struct vnop_pagein_args * ap)
 {
 	mockfs_fsnode_t fsnode;
+	int result;
 
 	fsnode = (mockfs_fsnode_t) vnode_fsnode(ap->a_vp);
 
-	return cluster_pagein(ap->a_vp, ap->a_pl, ap->a_pl_offset,
+	result = cluster_pagein(ap->a_vp, ap->a_pl, ap->a_pl_offset,
 	    ap->a_f_offset, ap->a_size, fsnode->size, ap->a_flags);
+
+#if defined(ARM64_BOARD_CONFIG_POLARIS)
+	/*
+	 * POLARIS: a fault on an executable page ends up here.  A fault address
+	 * on the panel with no PG line for the same page means the mapping
+	 * never reached the pager; a PG line with a non-zero result means the
+	 * pager itself refused the page.
