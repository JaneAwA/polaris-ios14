+/*
+ * POLARIS: bring the framebuffer console up before pmap_init().
+ *
+ * arm_init() calls this right after its first progress cell so that anything
+ * panicking between there and the point where ml_io_map() starts working still
+ * gets its message on the panel instead of into the void.  The raw address is
+ * only valid while TTBR0 holds the identity table start.s built, which is
+ * exactly the window arm_vm_init() runs in.  serial_init() re-runs later and
+ * swaps fbcon_base for the kernel mapping.
+ */
+void
+polaris_console_early_init(void)
+{
+	if (fbcon_registered) {
+		return;
+	}
+	fbcon_init();
+	if (fbcon_base == NULL) {
+		return;
+	}
+	fbcon_registered = 1;
+	register_serial_functions(&polaris_fbcon_functions);
+}
+
+/*
+ * POLARIS: stop writing to the panel before TTBR0 leaves the identity table.
+ *
+ * The early console reaches the framebuffer through the raw address, which
+ * only start.s's table maps.  arm_vm_init() calls this just before it installs
+ * the kernel pmap; serial_init() re-registers fbcon_base through ml_io_map()
+ * later, and the cursor position survives, so nothing already printed is lost.
+ */
+void
+polaris_console_suspend(void)
+{
+	if (fbcon_physical) {
+		fbcon_base = NULL;
+	}
+}
+
 #else /* !ARM64_BOARD_CONFIG_POLARIS */
 
